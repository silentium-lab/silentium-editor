{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["zone.js"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2021", "dom"],
    "paths": {
      "@/*": ["./src/*"],
    },
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
  },
}
