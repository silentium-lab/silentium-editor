{
  "name": "capacitor-app",
  "version": "1.0.0",
  "description": "An Amazing Capacitor App",
  "type": "module",
  "keywords": [
    "capacitor",
    "mobile"
  ],
  "scripts": {
    "start": "vite --force",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "android-clean": "cd android && ./gradlew clean && cd ..",
    "android-sync": "npx cap sync android",
    "android-open": "npx cap open android",
    "android-run": "npx cap run android",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@capacitor/android": "8.0.2",
    "@capacitor/camera": "latest",
    "@capacitor/core": "latest",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/splash-screen": "latest",
    "@capawesome/capacitor-file-picker": "^8.0.1",
    "@lit/context": "^1.1.6",
    "draggabilly": "^3.0.0",
    "hammerjs": "^2.0.8",
    "immutable": "^5.1.4",
    "linkerline": "^1.6.1",
    "lit": "^3.3.2",
    "lodash-es": "^4.17.23",
    "nanostores": "^1.3.0",
    "object-hash": "^3.0.0",
    "scrollbooster": "^3.0.2",
    "silentium": "^0.0.228",
    "silentium-components": "^0.0.126",
    "silentium-loop": "^0.0.9",
    "silentium-morphdom": "^0.0.27",
    "silentium-ui": "^0.0.19",
    "silentium-web-api": "^0.0.41",
    "ts-invariant": "^0.10.3",
    "zone.js": "^0.16.0"
  },
  "overrides": {
    "silentium": "$silentium",
    "silentium-components": "$silentium-components"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "@eslint/js": "^10.0.1",
    "@lit/reactive-element": "^2.1.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/draggabilly": "^3.0.0",
    "@types/hammerjs": "^2.0.46",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.1.0",
    "@types/object-hash": "^3.0.6",
    "@types/webpack-env": "^1.18.8",
    "@types/wicg-file-system-access": "^2023.10.7",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "author": "",
  "license": "ISC"
}
